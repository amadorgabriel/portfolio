# GitHub personal access token (classic or fine-grained).
# Used for GraphQL pinned repos + repository search (topic:portfolio).
# Without it, unauthenticated API limits apply (~60 requests/hour).
#
# Create: https://github.com/settings/tokens
# Fine-grained: read access to public repositories (and Metadata) for your account.
# Classic: public_repo scope is enough for public data.
#
GITHUB_TOKEN=

# Public site URL (metadata, Open Graph, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://amadorgabriel.vercel.app

# Optional: Google Search Console verification meta tag
# GOOGLE_SITE_VERIFICATION=
